# --- Database (Neon PostgreSQL) ---
# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/poompavai?sslmode=require"
# Direct (non-pooled) connection string (used by prisma migrate / db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/poompavai?sslmode=require"

# --- Sessions ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=""

# --- Super Admin (Google sign-in only) ---
SUPER_ADMIN_EMAIL="owner@example.com"
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# Same value, exposed to the browser build (client IDs are public)
VITE_GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# --- Razorpay (secret stays server-side only) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Public key id for the browser Checkout widget (same as RAZORPAY_KEY_ID; the key *secret* is never exposed)

# --- Email verification codes (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="POOMPAVAI <no-reply@yourdomain.com>"

# --- Site ---
SITE_URL="https://www.example.com"

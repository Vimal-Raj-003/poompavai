{
  "name": "poompavai",
  "version": "1.0.0",
  "description": "POOMPAVAI - Thanjavur Thalaiyatti Bommai storefront",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env server/dev.mjs",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "assets": "node scripts/build-assets.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vimal-Raj-003/poompavai.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Vimal-Raj-003/poompavai/issues"
  },
  "homepage": "https://github.com/Vimal-Raj-003/poompavai#readme",
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-malayalam": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource-variable/noto-serif-malayalam": "^5.3.0",
    "@fontsource-variable/noto-serif-tamil": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",

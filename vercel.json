{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/product/:slug", "destination": "/api/page?type=product&slug=:slug" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets/|hero/|products/|.*\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(hero|products|assets)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
